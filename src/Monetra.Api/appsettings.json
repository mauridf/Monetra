{
  "Application": {
    "Name": "Monetra",
    "Environment": "Development",
    "Url": "http://localhost:5000",
    "CorsOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },

  "Jwt": {
    "SecretKey": "super-secret-key-with-at-least-512-bits-length-for-development-only-change-in-production",
    "Issuer": "monetra-api",
    "Audience": "monetra-app",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },

  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=monetra;Username=postgres;Password=Mt190720@;"
  },

  "Redis": {
    "ConnectionString": "localhost:6379"
  },

  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest"
  },

  "MinIo": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "monetra"
  },

  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Username": "",
    "Password": "",
    "FromEmail": "noreply@monetra.com.br",
    "FromName": "Monetra"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/monetra-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}
